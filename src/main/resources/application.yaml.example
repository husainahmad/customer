harmoni:
  user:
    db: pos-user
    password: "secret!"

spring:
  application:
    name: customer
  datasource:
    auth:
      mysql:
        driver-class-name: com.mysql.cj.jdbc.Driver
        jdbc-url: jdbc:mysql://localhost:3306/db-harmoni-auth?rewriteBatchedStatements=true
        username: ${harmoni.user.db}
        password: ${harmoni.user.password}
    type: org.apache.commons.dbcp2.BasicDataSource
    url: jdbc:mysql://localhost:3306/db-harmoni-auth
    username: ${harmoni.user.db}
    password: ${harmoni.user.password}
    driver-class-name: com.mysql.cj.jdbc.Driver

mybatis:
  mapper-locations: classpath*:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

spring:
  ai:
    openai:
      # Default: local Ollama — free, unlimited, offline, zero 429s, no API key.
      # Ollama must be running: `ollama serve && ollama pull qwen2.5:3b`
      # qwen2.5:3b = fast on CPU (~1s/turn). qwen3:4b = smarter but ~50s/turn (thinking).
      base-url: http://localhost:11434/v1
      api-key: ollama
      chat:
        completions-path: /chat/completions
        options:
          model: qwen2.5:3b
          temperature: 0.7
      # Alternative cloud providers — activate with -Dspring-boot.run.profiles=<name>:
      #   ollama-cloud: OLLAMA_API_KEY=<key from ollama.com/settings/keys>, model gpt-oss:20b (level-1, free monthly credits)
      #   gemini:       GEMINI_API_KEY (AIza... or AQ...), model gemini-flash-latest (NOT gemini-2.5-flash — decommissioned -> 404). Free tier = ~20 req/DAY — not production-usable.
      #   groq:         GROQ_API_KEY=gsk_xxx, model openai/gpt-oss-20b
harmoni:
  ai:
    enabled: true
    system-prompt: |
      You are Harmoni POS AI assistant.
  services:
    menu:
      base-url: http://127.0.0.1:8082
      timeout-ms: 3000
      endpoints:
        product-search: /api/v1/product/search
        product-by-id: /api/v1/product/{id}
        category-search: /api/v1/category/search
        category-by-brand: /api/v1/category/brand/{brandId}
        product-by-category-price: /api/v1/product/category/{id}/price
        product-by-category-paged: /api/v1/product/category/{categoryId}/{brandId}
    order:
      base-url: http://127.0.0.1:8083
      timeout-ms: 3000
      endpoints:
        create-order: /api/v1/order

server:
  port: 8084
  address: 127.0.0.1
