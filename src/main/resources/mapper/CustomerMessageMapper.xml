<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.harmoni.pos.customer.adapter.out.persistence.mybatis.CustomerMessageMapper">

    <sql id="baseColumns">
        id, session_id, role, message, created_at
    </sql>

    <resultMap id="messageMap"
               type="com.harmoni.pos.customer.adapter.out.persistence.mybatis.entity.CustomerMessageEntity">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="message" column="message"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findBySessionId" resultMap="messageMap">
        SELECT <include refid="baseColumns"/>
        FROM customer_messages
        WHERE session_id = #{sessionId}
        ORDER BY created_at ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countBySessionId" resultType="long">
        SELECT COUNT(*)
        FROM customer_messages
        WHERE session_id = #{sessionId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO customer_messages (session_id, role, message)
        VALUES (#{sessionId}, #{role}, #{message})
    </insert>

    <select id="findById" resultMap="messageMap">
        SELECT <include refid="baseColumns"/>
        FROM customer_messages
        WHERE id = #{id}
    </select>

</mapper>
