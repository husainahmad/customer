<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.harmoni.pos.customer.adapter.out.persistence.mybatis.CustomerSessionMapper">

    <sql id="baseColumns">
        id, customer_id, session_token, source, status, created_at, updated_at
    </sql>

    <resultMap id="sessionMap"
               type="com.harmoni.pos.customer.adapter.out.persistence.mybatis.entity.CustomerSessionEntity">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="sessionToken" column="session_token"/>
        <result property="source" column="source"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="sessionMap">
        SELECT <include refid="baseColumns"/>
        FROM customer_sessions
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO customer_sessions (customer_id, session_token, source, status)
        VALUES (#{customerId}, #{sessionToken}, #{source}, #{status})
    </insert>

    <update id="updateStatus">
        UPDATE customer_sessions
        SET status = #{status},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

</mapper>
